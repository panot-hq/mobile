{
  "expo": {
    "name": "Panot",
    "slug": "Panot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "Panot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.ahrm.panot",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Processes your recorded voice to automatically transcribe interactions into text.",
        "NSMicrophoneUsageDescription": "Records your voice notes to capture interaction without typing.",
        "NSContactsUsageDescription": "Allows you to select contacts to import. Imported data is securely uploaded to our servers to sync your account.",
        "NSCameraUsageDescription": "Allows you to take a photo to set as your profile picture.",
        "NSPhotoLibraryUsageDescription": "Allows you to choose an image from your gallery to use as a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.ahrm.panot"
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-web-browser",
      "expo-localization",
      [
        "expo-router",
        {
          "origin": "https://panot.com"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#000",
          "dark": {
            "image": "./assets/icons/splash-icon-light.png",
            "resizeMode": "contain",
            "backgroundColor": "#fff"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Enables you to select specific contacts from your address book to create their profiles in the app. We will be storing your contacts in our database and will not share them with any third parties or processed in any way."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ahrm.panot",
          "publishableKey": "pk_test_51SVcCbJXKGjQr9YZXn0gkfU7PXKmZ6MNW7cA5cvgSWGPH18X8W70QbCPC5xzi3neTLQaPckSahP0E4Cv45BDBpYp00TYe4lfqN"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72501028-5edd-466b-b1c0-7708941aaea3"
      }
    }
  }
}
